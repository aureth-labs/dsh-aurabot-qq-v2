{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2024"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "lib",
    "allowJs": false,
    "strict": true,
    // 从 .js 迁移过来的存量代码里空值判断极多（strictNullChecks 打开会有一万多条）；
    // 这里先只关「空值」与「catch 变量视为 unknown」两项，其余严格检查（函数参数双变、this、属性初始化等）保持开启。
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "removeComments": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": false
  },
  "include": ["src/**/*.ts", "packages/**/*.ts"],
  "exclude": ["packages/modules/*/web/**/*.ts", "src/**/*.d.ts", "packages/**/*.d.ts", "node_modules", "lib", "dist", "test"]
}
