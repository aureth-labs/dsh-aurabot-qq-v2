{
  "name": "dsh-aurabot-qq",
  "version": "1.3.0-rc.1",
  "description": "Aurabot：住在 QQ 里的 AI 伙伴「大肥鱼」—— DeepSeek Harness 插件（经 SnowLuma / OneBot v11 接 QQ）",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "index.mjs",
  "types": "./lib/src/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/types/index.d.ts",
      "default": "./index.mjs"
    },
    "./dev": "./dev.mjs",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && node scripts/check-lifecycle.mjs",
    "test": "node --import ./scripts/ts-resolution.mjs --test \"test/**/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "aurabot": {
    "api": 2
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "qq",
    "onebot"
  ],
  "files": [
    "dev.mjs",
    "src",
    "packages",
    "client",
    "lib",
    "dist",
    "models",
    "personas",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "README_EN.md"
  ],
  "optionalDependencies": {
    "onnxruntime-node": "^1.20.0",
    "puppeteer-finder": "^1.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aureth-labs/dsh-aurabot-qq.git"
  },
  "homepage": "https://github.com/aureth-labs/dsh-aurabot-qq",
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
